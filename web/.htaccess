# Page d'accueil explicite : le .htaccess parent (WordPress, DirectoryIndex index.php) ne doit pas masquer index.html
DirectoryIndex index.html

# Cache serveur de tides.php : pas servi directement
RedirectMatch 404 /cache/

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Fichiers légers sans build : revalidation à chaque visite (304 si inchangé)
  <FilesMatch "\.(html|js|css|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Tout en same-origin : tides.php relaie l'API, aucune ressource externe
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
